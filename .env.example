# Read by the web app (apps/web-app/vite.config.ts sets envDir to the repo
# root). Copy to .env.local and fill in.
#
# NOTE: CONVEX_DEPLOYMENT does NOT go here — the Convex CLI runs from
# packages/convex and manages packages/convex/.env.local itself on first
# `pnpm --filter @pocketcircle/convex dev` run.
#
# Secret lines below use the form VAR=<placeholder>.
VITE_CONVEX_URL=https://<your-deployment>.convex.cloud
VITE_CONVEX_SITE_URL=https://<your-deployment>.convex.site
# App origin Better Auth redirects back to (also set on the Convex deployment)
SITE_URL=http://127.0.0.1:5173
BETTER_AUTH_SECRET=<random-secret>
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
# Client error monitoring (ADR 0012). Optional locally; set in prod/beta.
# Production deploy.yml copies VITE_SENTRY_DSN onto Convex as SENTRY_DSN after a
# successful backend deploy, and removes it when the GitHub variable is empty.
# VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# Local Convex only — backend alerts without the production workflow:
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# Product analytics (ADR 0013). Optional locally; set in prod/beta.
# VITE_POSTHOG_KEY=phc_<project-key>
# VITE_POSTHOG_HOST=https://us.i.posthog.com
# Transactional email (Convex deployment only — set via `convex env set`; optional locally)
RESEND_API_KEY=<resend-api-key>
RESEND_FROM_EMAIL=<verified-from-address>
# Feedback delivery recipient (may differ from the public support address)
SUPPORT_EMAIL=arpitdalalm@gmail.com
# EMAIL_DEV_LOG=1  # Convex deployment: log email subject + HTML on every send
# MCP Worker ↔ Convex shared HMAC (Convex deployment + Worker secret; #318)
MCP_WORKER_HMAC_SECRET=<random-secret>
# Convex verifier only during a production key rotation. Never set on the Worker.
# MCP_WORKER_HMAC_SECRET_PREVIOUS=<previous-secret>
# Convex-only public ES256 keys for Worker→Convex assertions (current, then previous).
MCP_WORKER_VERIFYING_JWKS=<public-jwks-json>
# MCP Worker origin the SPA posts approval/deny to (required for local MCP + Connections)
VITE_MCP_WORKER_ORIGIN=http://127.0.0.1:8788
