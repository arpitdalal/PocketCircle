{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pocketcircle-mcp-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["global_fetch_strictly_public"],
  // Custom domain intentionally disabled until #318 is verified end-to-end.
  "workers_dev": true,
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "REPLACE_WITH_OAUTH_KV_NAMESPACE_ID" }],
  "durable_objects": {
    "bindings": [{ "name": "HANDOFF_STORE", "class_name": "HandoffStore" }]
  },
  "migrations": [{ "tag": "v1-handoff-store", "new_sqlite_classes": ["HandoffStore"] }],
  "vars": {
    "APP_ORIGIN": "https://pocketcircle.app",
    "CONVEX_SITE_URL": "https://pocketcircle.convex.site"
  }
}
