{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pocketcircle-mcp-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  // workers.dev kept for rollback/debug; production clients use the custom domain.
  "workers_dev": true,
  "routes": [{ "pattern": "mcp.pocketcircle.app", "custom_domain": true }],
  // OAuth metadata is derived from the request origin. Preview aliases would
  // advertise alternate issuers and resources that are not production origins.
  "preview_urls": false,
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "kv_namespaces": [
    // Binding name is account-scoped. Production deploy.yml substitutes
    // MCP_OAUTH_KV_NAMESPACE_ID. Local wrangler dev / vitest provision a
    // namespace from this binding without Cloudflare. The OAuth library still
    // reads env.OAUTH_KV — Worker code aliases via withWorkersOauthKv.
    { "binding": "POCKET_CIRCLE_OAUTH_KV", "id": "REPLACE_WITH_OAUTH_KV_NAMESPACE_ID" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "HANDOFF_STORE", "class_name": "HandoffStore" }]
  },
  "migrations": [{ "tag": "v1-handoff-store", "new_sqlite_classes": ["HandoffStore"] }],
  // Free-tier capacity shields (#331). Counters are location-local and permissive;
  // they protect shared quotas, they do not replace authorization. Keys and
  // upgrade triggers: docs/research/mcp-capacity-gates.md
  "ratelimits": [
    {
      "name": "MCP_AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "MCP_TOKEN_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "MCP_FAILED_AUTH_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      // Tighter than auth/token — each DCR is KV writes on Free (1k/day). #354
      "name": "MCP_DCR_RATE_LIMITER",
      "namespace_id": "1007",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "MCP_READ_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "MCP_WRITE_RATE_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "MCP_DESTRUCTIVE_RATE_LIMITER",
      "namespace_id": "1006",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://pocketcircle.app",
    // Production deploy.yml substitutes vars.VITE_CONVEX_SITE_URL. Never invent a
    // *.convex.site host — Convex assigns the deployment subdomain.
    "CONVEX_SITE_URL": "https://placeholder.convex.site",
    // DCR private-use redirect schemes (option C). Comma-separated, no `:`.
    "MCP_DCR_ALLOWED_SCHEMES": "cursor,vscode"
  }
}
