# Copy to .dev.vars (gitignored) for `wrangler dev` / local testing.
# Must match the Convex deployment's MCP_WORKER_HMAC_SECRET (see ../../.env.example).
MCP_WORKER_HMAC_SECRET=<random-secret>
# ES256 private JWK used only by the Worker for Worker→Convex assertions.
MCP_WORKER_SIGNING_PRIVATE_JWK=<private-jwk-json>
# Optional, temporary: enables POST /admin/oauth/clients. Remove after use.
# MCP_CLIENT_PROVISIONING_TOKEN=<random-secret>
# These override wrangler.jsonc `vars` for local wrangler only (vitest pins its own).
# APP_ORIGIN may be localhost or 127.0.0.1 — Worker treats them as equivalent on loopback.
APP_ORIGIN=http://127.0.0.1:5173
# Must match VITE_CONVEX_SITE_URL from repo-root .env.local (cloud Convex site).
CONVEX_SITE_URL=https://<your-deployment>.convex.site
# Self-hosted Docker only (scripts/e2e-local.sh / local backend on :3211):
# CONVEX_SITE_URL=http://127.0.0.1:3211
# Cursor / local MCP OAuth: wrangler remaps request URL+Host to the custom
# domain, so pin issuer/resource to the URL you put in mcp.json.
MCP_ISSUER=http://127.0.0.1:8788
MCP_RESOURCE_URI=http://127.0.0.1:8788/mcp
# Opt-in private-use redirect schemes for DCR (comma-separated). See research note.
MCP_DCR_ALLOWED_SCHEMES=cursor,vscode
