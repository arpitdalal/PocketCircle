{
  "name": "pocketcircle",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  // Assets-only (no `main`): static files on the Workers free tier; SPA deep
  // links fall back to `/index.html` without billable Worker invocations.
  "routes": [
    {
      // Must equal `APEX_HOSTNAME` in packages/domain/src/origins.ts — wrangler
      // config cannot import it, so `canonical-origins.test.ts` asserts the match.
      "pattern": "pocketcircle.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./apps/web-app/build/client",
    "not_found_handling": "single-page-application"
  }
}
