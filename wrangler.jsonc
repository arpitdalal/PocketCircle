{
  "name": "pocketcircle",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  // Assets-only (no `main`): static files on the Workers free tier; SPA deep
  // links fall back to `/index.html` without billable Worker invocations.
  "routes": [
    {
      // Must equal `APP_HOSTNAME` in packages/domain/src/origins.ts — wrangler
      // config cannot import it, so `canonical-origins.test.ts` asserts the match.
      //
      // The apex route this Worker used to claim as well was dropped by the ADR 0035
      // cutover (#411): the hostname belongs to `apps/site` alone, and two Workers
      // cannot both claim one. Every product path that used to answer here is a
      // static redirect on the marketing Site instead
      // (`apps/site/src/legacy-redirects.ts`), so a bookmark, a shared link, or an
      // already-delivered email still resolves — on the app origin.
      "pattern": "app.pocketcircle.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./apps/web-app/build/client",
    "not_found_handling": "single-page-application"
  }
}
